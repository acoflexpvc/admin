# ==============================================================================
# Acoflex Admin CMS Configuration
# Copy this file to .env.local for local development.
# IMPORTANT: Only the anonymous public key is used in frontend client code.
# NEVER add or expose the Supabase service_role key here.
# ==============================================================================

# Project URL (from Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon Public API Key (from Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# (Optional) Public Website Base URL to link "View on site"
VITE_PUBLIC_WEBSITE_URL=https://acoflex.com
